# ---------------------------------------------------------------------------
# openFrameworks build output
# ---------------------------------------------------------------------------
# Intermediates
obj/

# Compiled app + shipped DLLs live in bin/, but bin/data/ is tracked
# (fonts, shaders, calibration.json). Ignore everything in bin/ except data/.
bin/*
!bin/data/

# Object and library files
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.exp
*.ilk
*.pdb
*.idb

# ---------------------------------------------------------------------------
# Visual Studio
# ---------------------------------------------------------------------------
.vs/
*.user
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.aps
Debug/
Release/
x64/
Win32/
ipch/

# NOTE: *.sln, *.vcxproj, *.vcxproj.filters, Makefile, config.make and
# addons.make are intentionally NOT ignored. projectGenerator writes them,
# but committing them keeps the addon list and build settings reproducible.

# ---------------------------------------------------------------------------
# Python (services/hands, services/vision, services/voice, calibration)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# PlatformIO (firmware/loadcells, XIAO ESP32S3)
# ---------------------------------------------------------------------------
.pio/

# ---------------------------------------------------------------------------
# Model weights
# ---------------------------------------------------------------------------
# Weights are NOT in git and NOT in Git LFS. Roboflow already versions them;
# duplicating that here costs quota and breaks clones made without LFS.
# Provenance for every file that lands in models/ is logged in models/README.md.
# Scoped to models/ on purpose — a repo-wide *.bin would swallow firmware images.
models/**/*.pt
models/**/*.onnx
models/**/*.tflite
models/**/*.pth
models/**/*.weights
models/**/*.bin

# The log itself stays tracked.
!models/README.md

# ---------------------------------------------------------------------------
# OS junk
# ---------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.DS_Store?
._*
