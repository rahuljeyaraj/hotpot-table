# ---------------------------------------------------------------------------
# Runtime state — machine-written, never committed (v3 doc section 8)
# ---------------------------------------------------------------------------
# The hard rule: config is committed and human-edited, state is gitignored and
# machine-written. Committing state/ would make every run of the table produce
# a diff, and a merge would be two machines disagreeing about what a load cell
# read or what was in a bin.
state/

# The live config, seeded from config/system.default.json on first run. The
# default IS committed - it is the seed, and it is the only one anybody edits.
config/system.json

# Merged process logs from run.py, rotated per day.
logs/

# Captured training images. They go to Edge Impulse, not into git.
datasets/

# ---------------------------------------------------------------------------
# openFrameworks build output — of/hotpot-table/
# ---------------------------------------------------------------------------
# Intermediates
of/hotpot-table/obj/

# The compiled app and its shipped DLLs live in bin/, but bin/data/ is tracked
# (fonts, audio, keystone.json). Ignore everything in bin/ except data/.
of/hotpot-table/bin/*
!of/hotpot-table/bin/data/

# ...except screenshots, which are output to look at rather than data the app
# loads.
of/hotpot-table/bin/data/screenshots/

# Object and library files
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.exp
*.ilk
*.pdb
*.idb

# ---------------------------------------------------------------------------
# Visual Studio
# ---------------------------------------------------------------------------
.vs/
*.user
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.aps
Debug/
Release/
x64/
Win32/
ipch/

# NOTE: *.sln, *.vcxproj, *.vcxproj.filters, Makefile, config.make and
# addons.make are intentionally NOT ignored. projectGenerator writes them,
# but committing them keeps the addon list and build settings reproducible.

# ---------------------------------------------------------------------------
# Python — python/hotpot/
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# PlatformIO (firmware/loadcells, XIAO ESP32S3)
# ---------------------------------------------------------------------------
.pio/

# ---------------------------------------------------------------------------
# Model files
# ---------------------------------------------------------------------------
# Edge Impulse .eim files and any other trained weights. No Git LFS. Provenance
# for every file that lands in models/ is logged in models/README.md (v3 doc
# section 19.5).
models/**/*.eim
models/**/*.pt
models/**/*.onnx
models/**/*.tflite
models/**/*.pth
models/**/*.weights
models/**/*.bin
# MediaPipe Tasks model bundles (hand_landmarker.task — M5's tracker). Same
# rule as every other weight file here: re-downloadable, provenance logged in
# models/README.md, never in git.
models/**/*.task
# docs/ROBOFLOW_PATHWAY.md §6 step 4's Path B sidecar
# (classifier/rf_deploy.py's `<model>.classes.json`, read by
# backend_rf.RoboflowOnnxBackend) — tied to one specific deployed .onnx the
# same way the weights themselves are, not source data, same re-downloadable/
# not-diffed category as every pattern above it.
models/**/*.classes.json

# The log itself stays tracked.
!models/README.md

# The raw Edge Impulse Studio download (Deployment page, "C++ library") —
# same category as the *.eim/*.tflite rows above, re-downloadable and not
# meant to be diffed, just distributed as a zip instead of a single file.
models/*.zip

# ---------------------------------------------------------------------------
# tools/eim_cpp/ — the native classify CLI (classifier/backend_ei.py)
# ---------------------------------------------------------------------------
# vendor/ is the unzipped Edge Impulse C++ library export — same
# re-downloadable/not-diffed category as models/*.eim above, just shipped
# as a source tree instead of one file. tools/eim_cpp/CMakeLists.txt,
# main.cpp and this README-equivalent stay tracked; only the SDK drop
# itself does not.
tools/eim_cpp/vendor/
# Standard out-of-source CMake build directory.
tools/eim_cpp/build/

# ---------------------------------------------------------------------------
# OS junk
# ---------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.DS_Store?
._*
